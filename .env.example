# Copy to .env for docker-compose variable substitution (Stripe, JWT, supplier ingest).

JWT_SECRET=replace-with-long-random-string

# Required to register stonee_admin / stonee_supervisor / stonee_manager via /auth/register
STAFF_INVITE_CODE=

# Stripe (https://dashboard.stripe.com/apikeys) — test keys for development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# When STRIPE_SECRET_KEY is set, simulated POST /orders/:id/pay is off unless:
STRIPE_ALLOW_SIMULATED_PAY=true

# Frontend (Vite) — publishable key only; never commit secret keys to the browser bundle
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: require x-stonee-ingest-token on POST /api/supplier/sync/* and /ingest/*
SUPPLIER_INGEST_TOKEN=

# Shared by catalog-service → search-service POST /internal/invalidate-search-cache (omit in dev)
STONEE_CACHE_INVALIDATE_SECRET=

# api-gateway — см. info/SECURITY.md (production: задать STONEE_CORS_ORIGINS)
# STONEE_GATEWAY_RATE_LIMIT_MAX=600
# STONEE_CORS_ORIGINS=https://app.example.com,https://www.example.com

# KYC gate (order-service → user-service): одинаковый секрет на обоих сервисах; порог в USD (0 = выкл.)
# STONEE_INTERNAL_SECRET=long-random-shared-secret
# STONEE_KYC_ENFORCE_MIN_USD=1000
# STONEE_ALLOW_KYC_SELF_VERIFY=true   # только dev/staging: POST /api/user/auth/kyc/self-verify с Bearer

# supplier-service: max JSON body (bytes), max diamonds per ingest request (optional)
# SUPPLIER_BODY_LIMIT_BYTES=6291456
# MAX_DIAMONDS_PER_JSON_INGEST=3000

# supplier-service — Diamond Atelier feed (never commit real passwords; use secrets in prod)
# SUPPLIER_META_MONGO_URI=mongodb://mongodb:27017/stonee_supplier_meta
# DIAMOND_ATELIER_BASE_URL=https://api.diamondatelier.in:6023/api/GetStockList/GetStockListCertified
# DIAMOND_ATELIER_USER_NAME=
# DIAMOND_ATELIER_PASSWORD=
# DIAMOND_ATELIER_SUPPLIER_USER_ID=   # Mongo _id of the Diamond Atelier supplier user (see scripts/seed-stonee-core.mjs)
# DIAMOND_ATELIER_ROWS_PER_PAGE=5000
# DIAMOND_ATELIER_MAX_PAGES=200
# DIAMOND_ATELIER_UPSERT_CHUNK=200
# CATALOG_BODY_LIMIT_BYTES=20971520

# One-time local reset: only Stonee admin + Diamond Atelier supplier in user DB
# pnpm seed:core
# SEED_MONGO_URI=mongodb://127.0.0.1:27018/stonee_users
# seed:core also wipes catalog `diamonds` and POSTs search cache invalidation (host :3005 → search-service)
# SEED_SKIP_CATALOG_WIPE=1
# SEED_CATALOG_MONGO_URI=mongodb://127.0.0.1:27018/stonee_catalog
# SEED_SEARCH_SERVICE_URL=http://127.0.0.1:3005
# Defaults after pnpm seed:core: admin@local.com, da@local.com (override passwords in prod)
# SEED_STONEE_ADMIN_EMAIL=  SEED_STONEE_ADMIN_PASSWORD=
# SEED_DA_EMAIL=  SEED_DA_PASSWORD=
