{
  "name": "ftp-product-sync-service",
  "version": "1.0.0",
  "description": "LGDX FTP Product Synchronization Microservice",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:build": "docker build -t lgdx/ftp-sync-service .",
    "docker:run": "docker run --env-file .env -v /ftp-data:/ftp-data -p 21:21 -p 10000-10100:10000-10100 lgdx/ftp-sync-service"
  },
  "keywords": [
    "microservice",
    "ftp",
    "file-sync",
    "lgdx",
    "rabbitmq",
    "mongodb"
  ],
  "author": "LGDX Team",
  "license": "ISC",
  "dependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "amqplib": "^0.10.4",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "fs-extra": "^11.0.0",
    "ftp-srv": "^4.6.3",
    "ioredis": "^5.3.2",
    "mongoose": "^8.0.3",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.2",
    "telegraf": "^4.12.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.19.1",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
