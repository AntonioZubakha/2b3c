{
  "name": "legacy-ftp-poller-service",
  "version": "1.0.0",
  "description": "Polls the legacy lgdeal.com FTP server for supplier files and feeds them into the new processing pipeline",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "basic-ftp": "^5.0.5",
    "dotenv": "^16.4.5",
    "mongoose": "^8.0.3",
    "node-cron": "^3.0.3",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^22.19.1",
    "@types/node-cron": "^3.0.11",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
