{
  "name": "lgdx-backup-service",
  "version": "1.0.0",
  "description": "LGDX MongoDB Backup Service",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/**/*.ts",
    "backup": "ts-node src/backup.ts",
    "restore": "ts-node src/restore.ts",
    "test-backup": "ts-node src/test-backup.ts"
  },
  "keywords": ["backup", "mongodb", "lgdx"],
  "author": "LGDX Team",
  "license": "ISC",
  "dependencies": {
    "node-cron": "^3.0.3",
    "mongodb": "^6.3.0",
    "winston": "^3.11.0",
    "axios": "^1.6.0",
    "redis": "^4.6.13",
    "fs-extra": "^11.1.1",
    "archiver": "^6.0.1",
    "unzipper": "^0.10.14",
    "express": "^4.18.2",
    "prom-client": "^15.1.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/fs-extra": "^11.0.4",
    "@types/archiver": "^6.0.2",
    "@types/unzipper": "^0.10.9",
    "@types/express": "^4.17.21",
    "typescript": "^5.3.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  }
} 