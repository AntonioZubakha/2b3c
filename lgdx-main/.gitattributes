# Normalize line endings to LF for all text files
* text=auto eol=lf

# Windows batch/cmd files must stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicitly declare common text files as LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.sh   text eol=lf
*.env  text eol=lf
*.conf text eol=lf
*.nginx text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files — no conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
