{
  "name": "market-price-calculator-service",
  "version": "1.0.0",
  "description": "Background service for calculating and updating market prices for diamond products",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "nodemon --exec ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest",
    "test:integration": "jest --testPathPattern=integration",
    "calculate": "ts-node src/scripts/run-calculation.ts",
    "calculate:prod": "node dist/scripts/run-calculation.js",
    "test:advanced-smoother": "ts-node src/scripts/test-advanced-smoother.ts",
    "test:real-data": "ts-node src/scripts/test-real-data-advanced.ts",
    "test:advanced": "npm test advancedPriceSmoother.test.ts"
  },
  "keywords": [
    "diamond",
    "market-price",
    "calculator",
    "background-job",
    "scheduler"
  ],
  "author": "LGDX Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "ioredis": "^5.8.2",
    "mongoose": "^7.5.0",
    "node-schedule": "^2.1.1",
    "prom-client": "^15.1.2",
    "redis": "^4.7.1",
    "telegraf": "^4.15.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.5.0",
    "@types/node-schedule": "^2.1.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.6.2",
    "jest-runtime": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
