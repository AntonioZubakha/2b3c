{
  "name": "lgdx-server",
  "version": "1.0.0",
  "description": "LGDX Server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "tsc",
    "start:ts": "node dist/index.js",
    "dev:ts": "nodemon --exec ts-node src/index.ts",
    "worker:whatsapp": "node dist/whatsapp/whatsappWorker.js",
    "worker:whatsapp-baileys": "node dist/whatsapp/whatsappBaileysWorker.js",
    "worker:telegram-user": "node dist/telegramUser/telegramUserWorker.js",
    "dev:whatsapp-worker": "ts-node src/whatsapp/whatsappWorker.ts",
    "dev:ts:memory": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nodemon --exec ts-node src/index.ts",
    "dev:ts:gc": "nodemon --exec node -r tsconfig-paths/register --max-old-space-size=8192 --expose-gc ./node_modules/ts-node/dist/bin.js src/index.ts",
    "calculate-stats": "ts-node src/scripts/runCategoryStats.ts",
    "debug-category": "ts-node src/scripts/debugCategory.ts",
    "find-invalid": "ts-node src/scripts/findInvalidProducts.ts",
    "migrate-users-companies": "ts-node -r tsconfig-paths/register src/scripts/migrateUsersCompanies.ts",
    "backup-users-companies": "ts-node -r tsconfig-paths/register src/scripts/backupUsersCompanies.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "test:security": "jest --config jest.security.config.js",
    "test:performance": "jest --config jest.performance.config.js",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:performance && npm run test:e2e",
    "test:telegram": "ts-node src/test-telegram-notifications.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "load-test": "node scripts/load-test.js",
    "backup": "node scripts/backup-system.js",
    "backup:schedule": "node scripts/backup-system.js schedule",
    "postinstall": "npx --yes patch-package@8.0.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@hapi/boom": "^10.0.1",
    "@types/compression": "^1.7.5",
    "@types/date-fns": "^2.5.3",
    "@types/exceljs": "^0.5.3",
    "@types/node-telegram-bot-api": "^0.64.8",
    "@types/nodemailer": "^6.4.17",
    "@types/twilio": "^3.19.2",
    "@whiskeysockets/baileys": "6.6.0",
    "amqplib": "^0.10.8",
    "axios": "^1.11.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^10.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "form-data": "^4.0.4",
    "fs-extra": "^11.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "ip-range-check": "^0.2.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.41",
    "mongoose": "^6.0.11",
    "mongoose-sequence": "^5.3.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.1.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^7.0.5",
    "pino": "^9.6.0",
    "prom-client": "^15.1.2",
    "qrcode": "^1.5.4",
    "redis": "^4.6.13",
    "socket.io": "^4.7.2",
    "stripe": "^14.21.0",
    "telegraf": "^4.12.3",
    "telegram": "^2.26.22",
    "tough-cookie": "^5.1.2",
    "twilio": "^5.7.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.15.21",
    "@types/node-cron": "^3.0.11",
    "@types/node-schedule": "^2.1.7",
    "@types/qrcode": "^1.5.5",
    "@types/stripe": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1",
    "autocannon": "^8.0.0",
    "aws-sdk": "^2.1692.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.2.2"
  }
}
